# Copy to .env and fill in real values (.env is not versioned).

# Postgres password (use only letters and numbers: it is embedded in connection URLs).
POSTGRES_PASSWORD=change-me

# n8n credential encryption key. Generate once and never change it
# (e.g. `openssl rand -hex 32`), or n8n will not be able to read saved credentials.
N8N_ENCRYPTION_KEY=change-me

# Timezone used by n8n and the containers.
TZ=America/Sao_Paulo

# Folder whose subfolders become workspaces (host path, mounted with write access into the server).
# Change it from Settings > Geral when studio.ps1 is running.
PROJECTS_HOST_DIR=D:/Projetos

# Top-level folders that never become workspaces (comma-separated, case-insensitive).
SCAN_EXCLUDE=Pessoais

# Key that encrypts git/agent tokens in the database (64 hex chars, e.g. `openssl rand -hex 32`).
# Never change it after saving accounts, or the saved tokens become unreadable.
STUDIO_ENCRYPTION_KEY=change-me

# Claude skills folder (only this subfolder of ~/.claude is mounted, read-only).
CLAUDE_SKILLS_HOST_DIR=C:/Users/your-user/.claude/skills

# Folder where each agent gets its isolated clone of the project (created if missing).
AGENTS_HOST_DIR=D:/AgentsWorktrees

# Launching an agent asks for confirmation when Docker memory/CPU usage reaches these percentages.
AGENT_LAUNCH_MEMORY_PERCENT=80
AGENT_LAUNCH_CPU_PERCENT=85

# Workflows stop starting agents while the Claude 5-hour window is at or above this percentage.
WORKFLOW_PLAN_LIMIT_PERCENT=80

# Marks the login cookie Secure. Keep false while the Studio is served over http (studio.localhost).
COOKIE_SECURE=false

# Tunnel for the git webhooks (optional, ngrok): the authtoken and the free static domain from the ngrok dashboard,
# and COMPOSE_PROFILES=tunnel to start it with the Studio. The public address goes in Configurações > Webhooks dos quadros.
# COMPOSE_PROFILES=tunnel
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=xxx.ngrok-free.app
