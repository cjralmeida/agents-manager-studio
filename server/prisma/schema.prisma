generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum GitProvider {
  GITHUB
  GITLAB
  OTHER

  @@map("git_provider")
}

/// A top-level folder of the projects root (e.g. D:\Projetos\GlobalFarm).
model Workspace {
  id        String    @id @default(uuid(7)) @db.Uuid
  /// Folder name; unique because it identifies the folder on disk.
  name      String    @unique
  isIgnored Boolean   @default(false) @map("is_ignored")
  /// Set when the folder disappears from disk; cleared if it comes back.
  missingAt DateTime? @map("missing_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects    Project[]
  settings    WorkspaceSettings?
  gitAccounts WorkspaceGitAccount[]
  agents      Agent[]
  taskBoard   TaskBoard?

  @@map("workspaces")
}

/// A folder inside a workspace, where agents work on the code.
model Project {
  id           String       @id @default(uuid(7)) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  name         String
  isGitRepo    Boolean      @default(false) @map("is_git_repo")
  /// "origin" remote, without embedded credentials.
  gitRemoteUrl String?      @map("git_remote_url")
  gitProvider  GitProvider? @map("git_provider")
  missingAt    DateTime?    @map("missing_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    Agent[]

  @@unique([workspaceId, name])
  @@map("projects")
}

enum AgentProvider {
  CLAUDE

  @@map("agent_provider")
}

/// GitHub/GitLab credentials used by agents to push and open PRs/MRs.
model GitAccount {
  id             String      @id @default(uuid(7)) @db.Uuid
  /// GITHUB or GITLAB (OTHER is not accepted for accounts).
  provider       GitProvider
  label          String
  /// API host, e.g. github.com or gitlab.company.com; matched against project remotes.
  host           String
  /// Username reported by the provider when the token was verified.
  username       String
  /// Commit author; falls back to the username when empty.
  authorName     String?     @map("author_name")
  authorEmail    String?     @map("author_email")
  tokenEncrypted String      @map("token_encrypted")
  /// Last characters of the token, safe to display.
  tokenHint      String      @map("token_hint")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaces WorkspaceGitAccount[]

  @@map("git_accounts")
}

/// Agent provider credentials (Claude subscription token from `claude setup-token`).
model AgentAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  provider       AgentProvider @default(CLAUDE)
  label          String
  tokenEncrypted String        @map("token_encrypted")
  tokenHint      String        @map("token_hint")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaceSettings WorkspaceSettings[]

  @@map("agent_accounts")
}

model WorkspaceSettings {
  workspaceId     String   @id @map("workspace_id") @db.Uuid
  agentAccountId  String?  @map("agent_account_id") @db.Uuid
  /// Skill ids (path relative to the skills folder) enabled for agents of this workspace.
  enabledSkillIds String[] @default([]) @map("enabled_skill_ids")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentAccount AgentAccount? @relation(fields: [agentAccountId], references: [id], onDelete: SetNull)

  @@index([agentAccountId])
  @@map("workspace_settings")
}

model WorkspaceGitAccount {
  workspaceId  String @map("workspace_id") @db.Uuid
  gitAccountId String @map("git_account_id") @db.Uuid

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gitAccount GitAccount @relation(fields: [gitAccountId], references: [id], onDelete: Cascade)

  @@id([workspaceId, gitAccountId])
  @@index([gitAccountId])
  @@map("workspace_git_accounts")
}

enum AgentStatus {
  PREPARING
  RUNNING
  WAITING_INPUT
  READY_FOR_REVIEW
  FINALIZING
  COMPLETED
  FAILED
  CANCELLED

  @@map("agent_status")
}

enum AgentInboxKind {
  MESSAGE
  ANSWER

  @@map("agent_inbox_kind")
}

/// A coding agent working on an isolated clone of a project.
model Agent {
  id              String      @id @default(uuid(7)) @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  title           String
  /// Model alias passed to Claude Code (sonnet, opus, haiku).
  model           String
  status          AgentStatus @default(PREPARING)
  baseBranch      String      @map("base_branch")
  /// Commit the agent branch started from; the review diff is computed against it.
  baseCommit      String?     @map("base_commit")
  branch          String
  /// Clone folder relative to the agents root (e.g. GlobalFarm/agro-gf-01a2b3c4).
  workdir         String
  /// Claude Code session, used to resume after the container stops.
  sessionId       String?     @map("session_id")
  /// Set while a container is running for this agent.
  containerId     String?     @map("container_id")
  /// SHA-256 of the secret the running container uses to call the server.
  secretHash      String?     @map("secret_hash")
  /// Question waiting for the user (AskUserQuestion input).
  pendingQuestion Json?       @map("pending_question")
  prUrl           String?     @map("pr_url")
  /// Board item the agent is solving (see TaskBoard); moved across columns as the agent progresses.
  taskItemId      String?     @map("task_item_id")
  /// Issue reference, e.g. GlobalFarm-Hub/automacoes#12 (null for draft items).
  taskRef         String?     @map("task_ref")
  taskUrl         String?     @map("task_url")
  errorMessage    String?     @map("error_message")
  lastActivityAt  DateTime    @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events    AgentEvent[]
  inbox     AgentInbox[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([taskItemId])
  @@map("agents")
}

/// Timeline of an agent: messages, tool calls, questions, status changes.
model AgentEvent {
  id        Int      @id @default(autoincrement())
  agentId   String   @map("agent_id") @db.Uuid
  type      String
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, id])
  @@map("agent_events")
}

/// Messages and answers waiting to be delivered to the agent container.
model AgentInbox {
  id          Int            @id @default(autoincrement())
  agentId     String         @map("agent_id") @db.Uuid
  kind        AgentInboxKind
  payload     Json
  deliveredAt DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, deliveredAt])
  @@map("agent_inbox")
}

/// Task board (GitHub Project v2 or GitLab group issue board) linked to a workspace.
model TaskBoard {
  workspaceId String      @id @map("workspace_id") @db.Uuid
  provider    GitProvider
  /// API host; the workspace git account for this host is used to talk to the board.
  host        String
  /// GitHub: project node id. GitLab: "<groupId>:<boardId>".
  externalId  String      @map("external_id")
  /// GitHub owner login or GitLab group path.
  ownerPath   String      @map("owner_path")
  title       String
  url         String
  /// Board guidelines; GitHub reads them from the project README, GitLab keeps them here.
  readme      String?
  /// Column id for each role (todo, inProgress, review, done, blocked) used by agent automation.
  statusMap   Json        @default("{}") @map("status_map")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("task_boards")
}

/// Global key/value settings of the Studio (e.g. the GitHub board template).
model StudioSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("studio_settings")
}
