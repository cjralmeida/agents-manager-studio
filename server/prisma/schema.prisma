generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum GitProvider {
  GITHUB
  GITLAB
  OTHER

  @@map("git_provider")
}

/// Where a workspace board lives: a provider board, or only in the Studio (tasks in local_tasks).
enum BoardProvider {
  GITHUB
  GITLAB
  STUDIO

  @@map("board_provider")
}

/// A top-level folder of the projects root (e.g. D:\Projetos\GlobalFarm).
/// Studio users. Everything a user creates (workspaces, accounts, board model) is theirs alone.
enum UserRole {
  ADMIN
  MEMBER

  @@map("user_role")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  /// scrypt hash with its salt and cost (lib/password.ts).
  passwordHash String    @map("password_hash")
  role         UserRole  @default(MEMBER)
  /// "system" follows the OS; "light" or "dark" pins it.
  theme        String    @default("system")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  settings         UserSetting[]
  workspaces       Workspace[]
  gitAccounts      GitAccount[]
  agentAccounts    AgentAccount[]
  renderAccounts   RenderAccount[]
  clickupAccounts  ClickupAccount[]
  pixellabAccounts PixellabAccount[]

  @@map("users")
}

/// Login session; the cookie holds a random token and only its SHA-256 is stored here.
model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Per-user key/value settings (board model, GitHub board template).
model UserSetting {
  userId    String   @map("user_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_settings")
}

model Workspace {
  id        String    @id @default(uuid(7)) @db.Uuid
  /// The user the workspace belongs to; other users do not see it.
  ownerId   String    @map("owner_id") @db.Uuid
  /// Folder name; unique because it identifies the folder on disk.
  name      String    @unique
  isIgnored Boolean   @default(false) @map("is_ignored")
  /// Set when the folder disappears from disk; cleared if it comes back.
  missingAt DateTime? @map("missing_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects        Project[]
  settings        WorkspaceSettings?
  gitAccounts     WorkspaceGitAccount[]
  agents          Agent[]
  taskBoards      TaskBoard[]
  localTasks      LocalTask[]
  workflows       Workflow[]
  agentProfiles   AgentProfile[]
  renderServices  RenderService[]
  deployments     Deployment[]
  agentVariables  AgentVariable[]
  capacityReviews CapacityReview[]
  processes       WorkflowProcess[]
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("workspaces")
}

/// A folder inside a workspace, where agents work on the code.
model Project {
  id           String       @id @default(uuid(7)) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  name         String
  isGitRepo    Boolean      @default(false) @map("is_git_repo")
  /// "origin" remote, without embedded credentials.
  gitRemoteUrl String?      @map("git_remote_url")
  gitProvider  GitProvider? @map("git_provider")
  /// Branch agents start from and open PRs/MRs into (e.g. the homologation branch); null = the folder's current branch.
  baseBranch   String?      @map("base_branch")
  missingAt    DateTime?    @map("missing_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents         Agent[]
  renderServices RenderService[]
  localTasks     LocalTask[]
  previewBuilds  PreviewBuild[]
  preview        ProjectPreview?
  variables      ProjectVariable[]

  @@unique([workspaceId, name])
  @@map("projects")
}

enum PreviewBuildStatus {
  RUNNING
  PASSED
  FAILED

  @@map("preview_build_status")
}

/// A check of one commit of the project's base branch: install, build and tests in a throwaway container.
/// The latest PASSED build is the project's stable version, the one "Rodar" serves.
model PreviewBuild {
  id            String             @id @default(uuid(7)) @db.Uuid
  projectId     String             @map("project_id") @db.Uuid
  branch        String
  commit        String
  commitMessage String             @default("") @map("commit_message")
  /// How the project runs: "static" (Node build served as files), "dockerfile" or "compose".
  kind          String             @default("static")
  /// What "Rodar" opens: the site folder (static), the container port (dockerfile) or "service:port" (compose).
  target        String?
  status        PreviewBuildStatus @default(RUNNING)
  /// Last lines of the check's output (the reason when it failed).
  log           String             @default("")
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@map("preview_builds")
}

/// "Rodar" of a project: whether the user wants it up, and the container serving its stable build.
model ProjectPreview {
  projectId   String   @id @map("project_id") @db.Uuid
  wantsUp     Boolean  @default(false) @map("wants_up")
  containerId String?  @map("container_id")
  /// Build being served (a PASSED one).
  buildId     String?  @map("build_id") @db.Uuid
  error       String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_previews")
}

enum AgentProvider {
  CLAUDE

  @@map("agent_provider")
}

/// GitHub/GitLab credentials used by agents to push and open PRs/MRs.
model GitAccount {
  id             String      @id @default(uuid(7)) @db.Uuid
  /// The user the account belongs to.
  ownerId        String      @map("owner_id") @db.Uuid
  /// GITHUB or GITLAB (OTHER is not accepted for accounts).
  provider       GitProvider
  label          String
  /// API host, e.g. github.com or gitlab.company.com; matched against project remotes.
  host           String
  /// Username reported by the provider when the token was verified.
  username       String
  /// Commit author; falls back to the username when empty.
  authorName     String?     @map("author_name")
  authorEmail    String?     @map("author_email")
  tokenEncrypted String      @map("token_encrypted")
  /// Last characters of the token, safe to display.
  tokenHint      String      @map("token_hint")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaces WorkspaceGitAccount[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("git_accounts")
}

/// Agent provider credentials (Claude subscription token from `claude setup-token`).
model AgentAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// The user the account belongs to.
  ownerId        String        @map("owner_id") @db.Uuid
  provider       AgentProvider @default(CLAUDE)
  label          String
  tokenEncrypted String        @map("token_encrypted")
  tokenHint      String        @map("token_hint")
  /// Last plan rate-limit reading (5-hour and weekly windows), sent by Claude with every request.
  planUsage      Json?         @map("plan_usage")
  planUsageAt    DateTime?     @map("plan_usage_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaceSettings WorkspaceSettings[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("agent_accounts")
}

model WorkspaceSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  agentAccountId    String?  @map("agent_account_id") @db.Uuid
  /// Render account used to deploy this workspace's projects.
  renderAccountId   String?  @map("render_account_id") @db.Uuid
  /// ClickUp account agents read tasks from (read-only tools).
  clickupAccountId  String?  @map("clickup_account_id") @db.Uuid
  /// PixelLab account (pixel art generation) for agents with the "pixellab" tool.
  pixellabAccountId String?  @map("pixellab_account_id") @db.Uuid
  /// Skill ids (path relative to the skills folder) enabled for agents of this workspace.
  enabledSkillIds   String[] @default([]) @map("enabled_skill_ids")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentAccount    AgentAccount?    @relation(fields: [agentAccountId], references: [id], onDelete: SetNull)
  renderAccount   RenderAccount?   @relation(fields: [renderAccountId], references: [id], onDelete: SetNull)
  clickupAccount  ClickupAccount?  @relation(fields: [clickupAccountId], references: [id], onDelete: SetNull)
  pixellabAccount PixellabAccount? @relation(fields: [pixellabAccountId], references: [id], onDelete: SetNull)

  @@index([agentAccountId])
  @@index([renderAccountId])
  @@index([clickupAccountId])
  @@index([pixellabAccountId])
  @@map("workspace_settings")
}

model WorkspaceGitAccount {
  workspaceId  String @map("workspace_id") @db.Uuid
  gitAccountId String @map("git_account_id") @db.Uuid

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gitAccount GitAccount @relation(fields: [gitAccountId], references: [id], onDelete: Cascade)

  @@id([workspaceId, gitAccountId])
  @@index([gitAccountId])
  @@map("workspace_git_accounts")
}

/// TASK: a coding/working agent. ASSISTANT: an Órbi conversation (hidden from dashboards and histories).
enum AgentKind {
  TASK
  ASSISTANT

  @@map("agent_kind")
}

/// What an agent delivers: code changes (commit + PR/MR) or a result reported through the Studio tools.
enum AgentOutput {
  PULL_REQUEST
  RESULT

  @@map("agent_output")
}

enum AgentStatus {
  PREPARING
  RUNNING
  WAITING_INPUT
  READY_FOR_REVIEW
  FINALIZING
  COMPLETED
  FAILED
  CANCELLED

  @@map("agent_status")
}

enum AgentInboxKind {
  MESSAGE
  ANSWER

  @@map("agent_inbox_kind")
}

/// A coding agent working on an isolated clone of a project.
model Agent {
  id                String      @id @default(uuid(7)) @db.Uuid
  workspaceId       String      @map("workspace_id") @db.Uuid
  /// Null for agents that do not work on a repository (they get an empty work folder).
  projectId         String?     @map("project_id") @db.Uuid
  kind              AgentKind   @default(TASK)
  /// Workspace agent (profile) this execution belongs to, if any.
  profileId         String?     @map("profile_id") @db.Uuid
  /// Role instructions of the profile, copied at launch and added to the system prompt.
  instructions      String      @default("")
  output            AgentOutput @default(PULL_REQUEST)
  /// Studio tools the agent may call (e.g. "board").
  tools             String[]    @default([])
  /// Projects mounted read-only at /context/<name> (from the profile when launched).
  contextProjectIds String[]    @default([]) @map("context_project_ids")
  /// Concludes by itself when it finishes (PR/MR or result) instead of waiting for the user.
  autoConclude      Boolean     @default(false) @map("auto_conclude")
  /// Copied from the workspace agent: merge the PR/MR as soon as it is opened.
  autoMerge         Boolean     @default(false) @map("auto_merge")
  /// Redis database index (1-15) held for its tests while it is not finished; see test-services.ts.
  testRedisDb       Int?        @map("test_redis_db")
  /// Outcome reported by the agent (studio_report_result) or collected by the Studio (created tasks).
  result            Json?
  title             String
  /// Model alias passed to Claude Code (sonnet, opus, haiku).
  model             String
  status            AgentStatus @default(PREPARING)
  baseBranch        String      @map("base_branch")
  /// Commit the agent branch started from; the review diff is computed against it.
  baseCommit        String?     @map("base_commit")
  branch            String
  /// Clone folder relative to the agents root (e.g. GlobalFarm/agro-gf-01a2b3c4).
  workdir           String
  /// Claude Code session, used to resume after the container stops.
  sessionId         String?     @map("session_id")
  /// Set while a container is running for this agent.
  containerId       String?     @map("container_id")
  /// SHA-256 of the secret the running container uses to call the server.
  secretHash        String?     @map("secret_hash")
  /// Question waiting for the user (AskUserQuestion input).
  pendingQuestion   Json?       @map("pending_question")
  prUrl             String?     @map("pr_url")
  /// Board item the agent is solving (see TaskBoard); moved across columns as the agent progresses.
  taskItemId        String?     @map("task_item_id")
  /// Issue reference, e.g. GlobalFarm-Hub/automacoes#12 (null for draft items).
  taskRef           String?     @map("task_ref")
  taskUrl           String?     @map("task_url")
  /// Workflow run this execution belongs to, if any.
  workflowRunId     String?     @map("workflow_run_id") @db.Uuid
  /// Cumulative usage per model as last reported by the session; new reports are turned into AgentUsage deltas.
  usageTotals       Json        @default("{}") @map("usage_totals")
  /// Estimated cost (API list prices) of everything the agent used.
  costUsd           Float       @default(0) @map("cost_usd")
  errorMessage      String?     @map("error_message")
  /// Set when a turn stopped on the Claude plan limit: the Studio resumes the agent at this time (see plan-limit).
  limitResumeAt     DateTime?   @map("limit_resume_at")
  /// Set when the Studio deleted the agent's copy to free disk (see agents/cleanup.ts); it can no longer continue.
  workdirRemovedAt  DateTime?   @map("workdir_removed_at")
  lastActivityAt    DateTime    @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  finishedAt        DateTime?   @map("finished_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile         AgentProfile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  workflowRun     WorkflowRun?        @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  events          AgentEvent[]
  inbox           AgentInbox[]
  usage           AgentUsage[]
  proposals       AssistantProposal[]
  capacityReviews CapacityReview[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([profileId])
  @@index([workspaceId, kind])
  @@index([status])
  @@index([taskItemId])
  @@index([workflowRunId])
  @@map("agents")
}

/// Timeline of an agent: messages, tool calls, questions, status changes.
model AgentEvent {
  id        Int      @id @default(autoincrement())
  agentId   String   @map("agent_id") @db.Uuid
  type      String
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, id])
  @@map("agent_events")
}

/// Messages and answers waiting to be delivered to the agent container.
model AgentInbox {
  id          Int            @id @default(autoincrement())
  agentId     String         @map("agent_id") @db.Uuid
  kind        AgentInboxKind
  payload     Json
  deliveredAt DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, deliveredAt])
  @@map("agent_inbox")
}

/// Task board (GitHub Project v2 or GitLab group issue board) linked to a workspace.
/// A source of tasks of a workspace board: a GitHub Project, a GitLab group board or the Studio's own tasks. A
/// workspace board joins all its sources on the board model's columns and fields.
model TaskBoard {
  id                 String        @id @default(uuid(7)) @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  provider           BoardProvider
  /// API host; the workspace git account for this host is used to talk to the board.
  host               String
  /// GitHub: project node id. GitLab: "<groupId>:<boardId>".
  externalId         String        @map("external_id")
  /// GitHub owner login or GitLab group path.
  ownerPath          String        @map("owner_path")
  title              String
  url                String
  /// Board guidelines; GitHub reads them from the project README, GitLab keeps them here.
  readme             String?
  /// Column id for each role (todo, inProgress, review, done, blocked) used by agent automation.
  statusMap          Json          @default("{}") @map("status_map")
  /// GitLab lists labels alphabetically: order of the fields and their options set in the Studio editor
  /// ({ fields: string[], options: { [field]: string[] } }); null keeps the template order.
  fieldOrder         Json?         @map("field_order")
  /// How the provider board matches the Studio board model (provider id -> model id for columns, fields
  /// and options); null until the board is converted to the model.
  modelMap           Json?         @map("model_map")
  /// "synced" (follows the model), "drift" (changed on the provider) or "pending" (never converted).
  modelStatus        String        @default("pending") @map("model_status")
  /// Why the last sync with the model failed.
  modelSyncError     String?       @map("model_sync_error")
  /// The server reads the board from the provider this often (and then runs the sentinels).
  refreshIntervalSec Int           @default(120) @map("refresh_interval_sec")
  lastSyncedAt       DateTime?     @map("last_synced_at") @db.Timestamptz(3)
  lastSyncError      String?       @map("last_sync_error")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// A provider board belongs to one workspace only (and a workspace has one Studio source).
  @@unique([provider, host, externalId])
  @@index([workspaceId])
  @@map("task_boards")
}

/// Task of a board that lives only in the Studio (BoardProvider STUDIO); columns and fields are the board model's.
model LocalTask {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Sequential per workspace, shown as #N.
  number      Int
  title       String
  body        String   @default("")
  /// Board model column id.
  columnId    String   @map("column_id")
  /// Board model field id -> option id.
  fields      Json     @default("{}")
  /// Workspace project the task belongs to; null = no project (like a GitHub draft).
  projectId   String?  @map("project_id") @db.Uuid
  assignees   String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, number])
  @@index([workspaceId, columnId])
  @@map("local_tasks")
}

/// Global key/value settings of the Studio (e.g. the GitHub board template).
model StudioSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("studio_settings")
}

/// Tokens and estimated cost an agent used between two reports, per model; summed for the usage dashboard.
/// Kept when the agent is deleted, so the history of consumption stays complete.
model AgentUsage {
  id                  Int      @id @default(autoincrement())
  agentId             String?  @map("agent_id") @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  model               String
  inputTokens         Int      @map("input_tokens")
  outputTokens        Int      @map("output_tokens")
  cacheReadTokens     Int      @map("cache_read_tokens")
  cacheCreationTokens Int      @map("cache_creation_tokens")
  costUsd             Float    @map("cost_usd")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([agentId])
  @@map("agent_usage")
}

/// A fixed agent of the workspace (e.g. "Documentador", "Testador"); each run of it is an Agent.
model AgentProfile {
  id                String      @id @default(uuid(7)) @db.Uuid
  workspaceId       String      @map("workspace_id") @db.Uuid
  name              String
  description       String      @default("")
  /// Role instructions added to the system prompt of every execution.
  instructions      String      @default("")
  model             String      @default("sonnet")
  /// Projects it may work on; empty means it works without a repository.
  projectIds        String[]    @default([]) @map("project_ids")
  output            AgentOutput @default(PULL_REQUEST)
  /// Studio tools enabled (e.g. "board").
  tools             String[]    @default([])
  /// Projects the agent can read (mounted read-only, local folder as it is), e.g. code to document.
  contextProjectIds String[]    @default([]) @map("context_project_ids")
  /// Works on whichever project of the workspace the workflow is on (e.g. the game repository an earlier step
  /// created), instead of fixed projects.
  anyProject        Boolean     @default(false) @map("any_project")
  /// Concludes by itself when it finishes, without waiting for the user.
  autoConclude      Boolean     @default(false) @map("auto_conclude")
  /// Merges its own PR/MR right after opening it (e.g. documentation the next workflow step reads).
  autoMerge         Boolean     @default(false) @map("auto_merge")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    Agent[]

  @@unique([workspaceId, name])
  @@map("agent_profiles")
}

/// Deploy environments; deploys always start in homologation.
enum DeployEnvironment {
  HOMOLOGACAO
  PRODUCAO

  @@map("deploy_environment")
}

/// Render account (API key encrypted like the other tokens); workspaces pick one in their settings.
model RenderAccount {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// The user the account belongs to.
  ownerId         String   @map("owner_id") @db.Uuid
  label           String
  apiKeyEncrypted String   @map("api_key_encrypted")
  apiKeyHint      String   @map("api_key_hint")
  /// Workspace/team name reported by Render when the key was checked.
  ownerName       String   @map("owner_name")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaceSettings WorkspaceSettings[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("render_accounts")
}

/// Render service that runs a project in an environment.
model RenderService {
  id           String            @id @default(uuid(7)) @db.Uuid
  workspaceId  String            @map("workspace_id") @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  environment  DeployEnvironment
  serviceId    String            @map("service_id")
  serviceName  String            @map("service_name")
  /// Branch the service deploys from, as configured on Render.
  branch       String?
  url          String?
  dashboardUrl String?           @map("dashboard_url")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment])
  @@map("render_services")
}

/// A deploy started by the Studio; followed until it is live or fails (also after a restart).
model Deployment {
  id             String            @id @default(uuid(7)) @db.Uuid
  workspaceId    String            @map("workspace_id") @db.Uuid
  projectId      String?           @map("project_id") @db.Uuid
  environment    DeployEnvironment
  serviceId      String            @map("service_id")
  serviceName    String            @map("service_name")
  renderDeployId String?           @map("render_deploy_id")
  /// Render status (created, build_in_progress, live, build_failed...) or "merging" / "error" before Render.
  status         String
  commitId       String?           @map("commit_id")
  prUrl          String?           @map("pr_url")
  agentId        String?           @map("agent_id") @db.Uuid
  error          String?
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?         @map("finished_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@index([finishedAt])
  @@map("deployments")
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@map("workflow_run_status")
}

enum WorkflowStepStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// Replaced by a new attempt after a later step sent the work back.
  RETRIED
  CANCELLED

  @@map("workflow_step_status")
}

/// A chain of steps (workspace agents or actions such as deploy) started by a trigger.
model Workflow {
  id                String    @id @default(uuid(7)) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  name              String
  description       String    @default("")
  isEnabled         Boolean   @default(true) @map("is_enabled")
  /// { type: "manual" } (a conversation started in the Studio) or { type: "board_task", ...filters }.
  trigger           Json
  /// Ordered steps; see modules/workflows/definition.ts.
  steps             Json
  /// Board trigger: runs of this workflow at the same time.
  maxConcurrentRuns Int       @default(1) @map("max_concurrent_runs")
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(3)
  statusMessage     String?   @map("status_message")
  /// Process the workflow belongs to (only organizes and shows; each workflow keeps its own trigger).
  processId         String?   @map("process_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  process   WorkflowProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  runs      WorkflowRun[]

  @@unique([workspaceId, name])
  @@index([processId])
  @@map("workflows")
}

/// A process groups the workflows that together reach one goal (e.g. "Criação de jogo"), shown as one canvas.
model WorkflowProcess {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflows Workflow[]

  @@unique([workspaceId, name])
  @@map("workflow_processes")
}

model WorkflowRun {
  id          String            @id @default(uuid(7)) @db.Uuid
  workflowId  String            @map("workflow_id") @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  title       String
  status      WorkflowRunStatus @default(RUNNING)
  /// { message } for a conversation, { taskItemId } for a board task.
  trigger     Json
  /// Board task that started the run (board trigger); it is picked again only after its runs finish.
  taskItemId  String?           @map("task_item_id")
  error       String?
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?         @map("finished_at") @db.Timestamptz(3)

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    WorkflowStepRun[]
  agents   Agent[]

  @@index([workflowId, status])
  @@index([workspaceId, startedAt])
  @@index([taskItemId])
  @@map("workflow_runs")
}

/// One step of a run, in a lane: "main", or a board task id after a step that runs once per created task.
model WorkflowStepRun {
  id           String             @id @default(uuid(7)) @db.Uuid
  runId        String             @map("run_id") @db.Uuid
  stepId       String             @map("step_id")
  stepIndex    Int                @map("step_index")
  lane         String             @default("main")
  attempt      Int                @default(1)
  status       WorkflowStepStatus @default(RUNNING)
  agentId      String?            @map("agent_id") @db.Uuid
  deploymentId String?            @map("deployment_id") @db.Uuid
  /// Handoff for the next step: result, PR, created tasks, deploy status.
  output       Json?
  error        String?
  startedAt    DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(3)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([agentId])
  @@map("workflow_step_runs")
}

enum ProposalStatus {
  PENDING
  APPLIED
  DISCARDED
  FAILED

  @@map("proposal_status")
}

/// A change Órbi proposes (create a workflow, start a run...); it only happens when the user applies it.
model AssistantProposal {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// The Órbi conversation that proposed it.
  agentId     String         @map("agent_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  /// create_agent, update_agent, delete_agent, create_workflow, update_workflow, delete_workflow,
  /// start_workflow, cancel_run, create_task.
  kind        String
  summary     String
  payload     Json
  status      ProposalStatus @default(PENDING)
  /// What applying it produced (e.g. the created workflow id) or why it failed.
  result      Json?
  error       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt   DateTime?      @map("decided_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("assistant_proposals")
}

/// Value the workspace's agents can read in their container (e.g. a test login for homologation), encrypted.
model AgentVariable {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  key            String
  valueEncrypted String   @map("value_encrypted")
  valueHint      String   @map("value_hint")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("agent_variables")
}

/// ClickUp account (personal API token encrypted); agents only read tasks through it.
model ClickupAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  label          String
  tokenEncrypted String   @map("token_encrypted")
  tokenHint      String   @map("token_hint")
  /// ClickUp user the token belongs to, reported when it was checked.
  username       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaceSettings WorkspaceSettings[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("clickup_accounts")
}

/// Environment variables of a project for "Rodar" (build, tests and the running app); value encrypted.
model ProjectVariable {
  id             String   @id @default(uuid(7)) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  key            String
  valueEncrypted String   @map("value_encrypted")
  valueHint      String   @map("value_hint")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("project_variables")
}

/// One analysis of the Gestor de Capacidade: what it saw (signals) and the Órbi conversation that studied it.
model CapacityReview {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Signals summed up; a new analysis starts only when it changes.
  signature   String
  signals     Json
  agentId     String?  @map("agent_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("capacity_reviews")
}

/// PixelLab account (API token encrypted): agents with the "pixellab" tool get PixelLab's MCP tools through it.
model PixellabAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  label          String
  tokenEncrypted String   @map("token_encrypted")
  tokenHint      String   @map("token_hint")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaceSettings WorkspaceSettings[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("pixellab_accounts")
}
